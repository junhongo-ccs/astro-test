---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Astro学習ノート" description="Astroを学びながら作っている個人サイト">
  <div class="grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-12">
    <div class="col-span-full lg:col-span-8">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Astro学習ノート
      </h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Astroの勉強を兼ねて作っているサイトです。コンポーネント、レイアウト、
        Content Collections、GitHub Pagesへのデプロイなどを試しています。
      </p>
    </div>

    <h2 class="col-span-full mt-6 text-xl font-semibold text-slate-900">最近の記事</h2>

    {
      posts.map((post) => (
        <a
          href={`${base}blog/${post.id}/`}
          class="col-span-full flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md sm:col-span-4 lg:col-span-4"
        >
          <p class="text-xs font-medium text-accent-700">
            {post.data.pubDate.toLocaleDateString('ja-JP')}
          </p>
          <h3 class="text-lg font-semibold text-slate-900">{post.data.title}</h3>
          <p class="text-sm text-slate-600">{post.data.description}</p>
        </a>
      ))
    }

    <div class="col-span-full">
      <a href={`${base}blog/`} class="text-sm font-medium text-accent-700 hover:text-accent-900">
        すべての記事を見る →
      </a>
    </div>
  </div>
</BaseLayout>
