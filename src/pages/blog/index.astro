---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="ブログ | Astro学習ノート" description="記事の一覧">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">ブログ</h1>

  <div class="mt-8 grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-12">
    {
      posts.map((post) => (
        <a
          href={`${base}blog/${post.id}/`}
          class="col-span-full flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md sm:col-span-4 lg:col-span-4"
        >
          <p class="text-xs font-medium text-accent-700">
            {post.data.pubDate.toLocaleDateString('ja-JP')}
          </p>
          <h2 class="text-lg font-semibold text-slate-900">{post.data.title}</h2>
          <p class="text-sm text-slate-600">{post.data.description}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-accent-100 px-3 py-0.5 text-xs font-medium text-accent-700">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
